{

 :ferment.protocol/default
 {:intents {:route/decide {:constraints {:max-chars 420}
                           :budget {:max-tokens 96
                                    :max-roundtrips 2}}
            :text/respond {:constraints {:max-chars 480
                                         :style/emoji :strip}
                           :budget {:max-tokens 220
                                    :max-roundtrips 2}}
            :problem/solve {:constraints {:max-chars 900}
                            :budget {:max-tokens 320
                                     :max-roundtrips 2}}}
  :policy/intents {:route/decide {:retry {:max-attempts 2
                                          :same-cap-max 1
                                          :fallback-max 0}
                                  :checks/hard ^:replace [:schema-valid]
                                  :checks/soft ^:replace []}
                   :text/respond {:done {:score-min 0.75}
                                  :checks/hard ^:replace [:schema-valid :no-truncated-ending :answer-known :no-markdown-heading :no-emoji]
                                  :checks/soft ^:replace [:no-hallucinated-apis]}
                   :problem/solve {:done {:score-min 0.78}
                                   :checks/hard ^:replace [:schema-valid :no-truncated-ending]
                                   :checks/soft ^:replace [:no-hallucinated-apis]}}}

}
